# Symfony Mailer DSN. Defaults to sendmail if unset.
# MAIL_DSN=smtp://user:pass@host:port
#
# If STARTTLS certificate verification fails against a smart-host relay
# (e.g. Exchange/O365), prefer pinning the relay's cert with peer_fingerprint
# over disabling verification outright:
# MAIL_DSN=smtp://spojenet-cz.mail.protection.outlook.com:25?peer_fingerprint=<sha1-or-sha256-hex-of-cert>
#
# verify_peer=0 disables TLS peer verification entirely and should only be
# used for relays on a trusted private network you control — never for
# arbitrary/public SMTP hosts, since it removes protection against MITM:
# MAIL_DSN=smtp://spojenet-cz.mail.protection.outlook.com:25?verify_peer=0
MAIL_FROM=info@vitexsoftware.cz

