{
  "$schema": "https://raw.githubusercontent.com/VitexSoftware/php-vitexsoftware-multiflexi-core/refs/heads/main/multiflexi.app.schema.json",
  "schemaVersion": "3.4.0",
  "uuid": "0fd52fdd-1c83-4346-b9f9-13e82bd5d6d0",
  "name": {
    "en": "Reminder",
    "cs": "Reminder"
  },
  "description": {
    "en": "Remind unsettled invoices",
    "cs": "Upomíná nezaplacené faktury"
  },
  "tags": [
    "AbraFlexi",
    "Reminder",
    "Mail",
    "Sms"
  ],
  "requirements": [
    "AbraFlexi",
    "Mail"
  ],
  "homepage": "https://github.com/VitexSoftware/abraflexi-reminder",
  "executable": "abraflexi-reminder",
  "events": {
    "emits": {
      "invoice.reminder.sent": {
        "description": "An overdue payment reminder was sent"
      }
    }
  },
  "environment": {
    "DEBUG": {
      "type": "bool",
      "description": {
        "en": "Enable debug mode",
        "cs": "Zapnout režim ladění"
      },
      "defval": "False",
      "required": false,
      "category": "Behavior"
    },
    "LANG": {
      "type": "set",
      "description": {
        "en": "Locale for this application",
        "cs": "Lokalizace pro tuto aplikaci"
      },
      "defval": "cs_CZ",
      "required": false,
      "options": [
        "cs_CZ",
        "en_US"
      ],
      "category": "Other"
    },
    "ABRAFLEXI_COMPANY": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Company",
        "cs": "AbraFlexi Společnost"
      },
      "defval": "demo_de",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_LOGIN": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Login",
        "cs": "AbraFlexi Login"
      },
      "defval": "winstrom",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_PASSWORD": {
      "type": "password",
      "description": {
        "en": "AbraFlexi password",
        "cs": "AbraFlexi password"
      },
      "defval": "winstrom",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_URL": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Server URI",
        "cs": "AbraFlexi Server URI"
      },
      "defval": "https://demo.flexibee.eu:5434",
      "required": true,
      "category": "API"
    },
    "MAX_MAIL_SIZE": {
      "type": "string",
      "description": {
        "en": "Maximum size of mail",
        "cs": "Maximální velikost e-mailu"
      },
      "defval": "",
      "required": true,
      "category": "Other"
    },
    "REMIND_FROM": {
      "type": "email",
      "description": {
        "en": "Remind sender mail Address",
        "cs": "Remind odeslater e-mail Address"
      },
      "defval": "",
      "required": true,
      "category": "Other"
    },
    "MAIL_DSN": {
      "type": "password",
      "description": {
        "en": "Symfony Mailer DSN for sending reminders (e.g. smtp://user:pass@host:port). Defaults to local sendmail if empty. Only use insecure options like verify_peer=0 for trusted internal/private relays; prefer peer_fingerprint to pin a self-signed cert instead of disabling TLS verification.",
        "cs": "DSN pro Symfony Mailer k odeslání upomínek (např. smtp://user:pass@host:port). Pokud je prázdné, použije se lokální sendmail. Nezabezpečené volby jako verify_peer=0 používejte pouze pro důvěryhodné interní/privátní relaye; pro self-signed certifikát preferujte peer_fingerprint místo vypnutí ověřování TLS."
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "MAIL_FROM": {
      "type": "email",
      "description": {
        "en": "Fallback sender address used when REMIND_FROM is not set",
        "cs": "Náhradní odesílatel použitý, pokud není nastaveno REMIND_FROM"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "SURRENDER_DAYS": {
      "type": "integer",
      "description": {
        "en": "Do not process old cases",
        "cs": "Nezpracovávat staré případy"
      },
      "defval": "365",
      "required": false,
      "category": "Other"
    },
    "REMINDER_SKIPDOCTYPE": {
      "type": "string",
      "description": {
        "en": "Ignore this document types",
        "cs": "Ignorovat tyto typy dokumentů"
      },
      "defval": "DOBROPIS,ZDD",
      "required": false,
      "category": "Other"
    },
    "QR_PAYMENTS": {
      "type": "bool",
      "description": {
        "en": "Add QR Codes into Mails",
        "cs": "Přidat QR kódy do e-mailů"
      },
      "defval": "True",
      "required": false,
      "category": "Other"
    },
    "ADD_LOGO": {
      "type": "bool",
      "description": {
        "en": "Add Company logo into Mails",
        "cs": "Přidat logo společnosti do e-mailů"
      },
      "defval": "True",
      "required": false,
      "category": "Other"
    },
    "MUTE": {
      "type": "bool",
      "description": {
        "en": "Send notifications to customers",
        "cs": "Zasílat upozornění zákazníkům"
      },
      "defval": "True",
      "required": false,
      "category": "Behavior"
    },
    "EASE_EMAILTO": {
      "type": "email",
      "description": {
        "en": "Fallback adres when MUTE is ON",
        "cs": "Záložní adresa pokud je MUTE zapnuto"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "SMS_SIGNATURE": {
      "type": "string",
      "description": {
        "en": "Signature at end of SMS",
        "cs": "Podpis na konci SMS"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "NO_REMIND_LABEL": {
      "type": "string",
      "description": {
        "en": "Ignore documents/customers with this Label",
        "cs": "Ignorovat dokumenty/zákazníky s tímto štítkem"
      },
      "defval": "NEUPOMINAT",
      "required": false,
      "category": "Other"
    },
    "SERVICE_TOGGLE_ENABLED": {
      "type": "bool",
      "description": {
        "en": "Enable setting the disconnect label on customers reaching the highest reminder level (isp-tools integration)",
        "cs": "Zapnout nastavení štítku pro odpojení u zákazníků na nejvyšší úrovni upomínek (integrace s isp-tools)"
      },
      "defval": "False",
      "required": false,
      "category": "Behavior"
    },
    "SERVICE_DISCONNECT_LABEL": {
      "type": "string",
      "description": {
        "en": "Label set on the customer's address record to mark them for disconnection",
        "cs": "Štítek nastavený na adresu zákazníka pro označení k odpojení"
      },
      "defval": "ODPOJENO",
      "required": false,
      "category": "Behavior"
    },
    "MODEM_IP": {
      "type": "string",
      "description": {
        "en": "Huawei E5180",
        "cs": "Huawei E5180"
      },
      "defval": "192.168.8.10",
      "required": false,
      "category": "Other"
    },
    "MODEM_PASSWORD": {
      "type": "string",
      "description": {
        "en": "Huawei E5180 Password",
        "cs": "Huawei E5180 Heslo"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "MAIL_CC": {
      "type": "email",
      "description": {
        "en": "CC Mail Address",
        "cs": "CC Mailová Adresa"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "SMS_ENGINE": {
      "type": "string",
      "description": {
        "en": "SMS Engine",
        "cs": "SMS Engine"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "RESULT_FILE": {
      "type": "string",
      "description": {
        "en": "write output json data to",
        "cs": "zapsat výstupní json data do"
      },
      "defval": "reminder_{ABRAFLEXI_COMPANY}.json",
      "required": false,
      "category": "Other"
    },
    "EASE_LOGGER": {
      "type": "string",
      "description": {
        "en": "write log messages using",
        "cs": "zapsat logovací zprávy pomocí"
      },
      "defval": "console|syslog",
      "required": false,
      "category": "Behavior"
    }
  },
  "exitCodes": {
    "0": {
      "description": {
        "en": "Success",
        "cs": "Úspěch"
      },
      "severity": "success",
      "retry": false
    }
  }
}
